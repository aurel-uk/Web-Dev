# ============================================
# CONFIG DIRECTORY PROTECTION
# ============================================
#
# Prevents direct web access to configuration files.
# These files should only be included by PHP scripts.
#
# ============================================

# Deny all access
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
