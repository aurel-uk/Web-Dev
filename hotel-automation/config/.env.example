# ============================================
# HOTEL AUTOMATION SAAS - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control!

# ============================================
# N8N CONFIGURATION
# ============================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_ENCRYPTION_KEY=your-32-character-encryption-key-here

# Webhook URL (public URL for webhooks)
WEBHOOK_URL=https://your-n8n-domain.com

# Execution settings
N8N_EXECUTIONS_MODE=queue
N8N_EXECUTIONS_DATA_PRUNE=true
N8N_EXECUTIONS_DATA_MAX_AGE=168

# ============================================
# DATABASE - POSTGRESQL
# ============================================
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=localhost
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=hotel_automation
DB_POSTGRESDB_USER=hotel_admin
DB_POSTGRESDB_PASSWORD=your-strong-password-here
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# Connection string (alternative)
DATABASE_URL=postgresql://hotel_admin:your-password@localhost:5432/hotel_automation

# ============================================
# OPENAI API
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORGANIZATION_ID=org-your-org-id

# Model configuration
OPENAI_MODEL_CLASSIFICATION=gpt-4o-mini
OPENAI_MODEL_RESPONSE=gpt-4o
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# ============================================
# WHATSAPP BUSINESS API (Meta Cloud API)
# ============================================
# Get these from Meta Business Suite > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token

# Webhook verification token (you create this)
WHATSAPP_VERIFY_TOKEN=your-custom-verify-token

# API version
WHATSAPP_API_VERSION=v18.0

# ============================================
# TWILIO (Voice Calls)
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Voice settings
TWILIO_VOICE_LANGUAGE_DEFAULT=en-US
TWILIO_SPEECH_TIMEOUT=3
TWILIO_SPEECH_MODEL=enhanced

# TTS voices
TWILIO_VOICE_EN=Google.en-US-Standard-C
TWILIO_VOICE_SQ=Google.sq-AL-Standard-A
TWILIO_VOICE_IT=Google.it-IT-Standard-A

# ============================================
# TELEGRAM BOT
# ============================================
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=HotelStatsBot

# Default notification chat (for system alerts)
TELEGRAM_ADMIN_CHAT_ID=123456789

# ============================================
# REDIS (Optional - for caching/queues)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# SECURITY SETTINGS
# ============================================
# JWT for API authentication
JWT_SECRET=your-jwt-secret-minimum-32-chars
JWT_EXPIRES_IN=24h

# API rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ALLOWED_ORIGINS=https://your-admin-dashboard.com

# ============================================
# HANDOFF SETTINGS
# ============================================
# Default confidence threshold (0.0 to 1.0)
HANDOFF_CONFIDENCE_THRESHOLD=0.75

# Timeout before automatic handoff (seconds)
HANDOFF_TIMEOUT_SECONDS=300

# Maximum AI turns before forced handoff
HANDOFF_MAX_AI_TURNS=5

# ============================================
# LOGGING & MONITORING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json

# Sentry (optional)
SENTRY_DSN=https://your-sentry-dsn

# ============================================
# TIMEZONE
# ============================================
TZ=Europe/Tirane
GENERIC_TIMEZONE=Europe/Tirane

# ============================================
# MULTI-TENANT SETTINGS
# ============================================
# Maximum hotels per instance
MAX_HOTELS=100

# Default subscription plan for new hotels
DEFAULT_SUBSCRIPTION_PLAN=basic

# Plans: basic (100 msgs/day), professional (1000), enterprise (unlimited)
PLAN_BASIC_DAILY_LIMIT=100
PLAN_PROFESSIONAL_DAILY_LIMIT=1000
PLAN_ENTERPRISE_DAILY_LIMIT=999999
